# Required — the portal can run arbitrary commands, so lock it down.
PORTAL_PASSWORD=change-me
# Keeps sessions valid across restarts: openssl rand -hex 32
PORTAL_SECRET=

# Where your workspaces live on the host
WORKSPACES_DIR=/root/repos

# host = pi runs inside the portal container (fast, full access to mounted repos)
# container = one isolated container per task (needs the docker socket mount)
EXECUTOR=host

PI_PROVIDER=openrouter
PI_MODEL=anthropic/claude-sonnet-5
OPENROUTER_API_KEY=

# A local llama.cpp server, if you run one. Reachable from inside the container
# at the same address as on the host, because the container shares its network.
LLAMA_BASE_URL=http://127.0.0.1:8080

# Web search. `docker compose up` brings up a SearXNG alongside the portal, so
# SEARXNG_URL already points at it and the only thing you must set is the
# secret — SearXNG refuses to start without one, deliberately.
#   openssl rand -hex 32
SEARXNG_SECRET=
SEARXNG_PORT=8888
# Only set this to point at a SearXNG you already run somewhere else. Unset
# means search is unavailable, and the agent is told so plainly rather than
# retrying a tool that cannot work.
SEARXNG_URL=

# The embedding server for semantic graph search (nomic-embed-text-v1.5, 768
# dims). Unset or unreachable falls back to keyword search.
EMBEDDING_BASE_URL=http://127.0.0.1:8101/v1/embeddings

# Tool names whose output should be treated as untrusted, beyond the ones the
# guard already knows. Set this when installing a pi package that reads the
# outside world under a name the guard has not heard of — otherwise its output
# arrives unwrapped and the injection guard is off for exactly the content it
# exists for. Comma-separated, additive only.
UNTRUSTED_TOOLS=
