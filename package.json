{
  "name": "pithagoras",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web",
    "docs"
  ],
  "scripts": {
    "build": "npm run build -w server && npm run build -w web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "start": "node --env-file-if-exists=.env server/dist/index.js",
    "docs": "npm run dev -w docs",
    "docs:build": "npm run build -w docs",
    "test:graph": "DATA_DIR=$(mktemp -d) node server/test/graph-contract.mjs",
    "test:prune": "node server/test/prune-contract.mjs",
    "test": "npm run test:graph && npm run test:prune && npm run test:web && npm run test:symbols && npm run test:llm && npm run test:cleanup && npm run test:self-concept && npm run test:guard && npm run test:trust && npm run test:self-update && npm run test:injector && npm run test:harvest && npm run test:assembler && npm run test:temporal && npm run test:executor && npm run test:curation && npm run test:mirror && npm run test:transcript && npm run test:health && npm run test:tools && npm run test:schedule && npm run test:ingest && npm run test:outline && npm run test:identity && npm run test:graph-server && npm run test:writing && npm run test:plan && npm run test:recovery && npm run test:supervisor && npm run test:steps",
    "test:web": "node server/test/web-contract.mjs",
    "test:symbols": "node server/test/code-index-contract.mjs",
    "test:llm": "node server/test/llm-contract.mjs",
    "test:cleanup": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node server/test/cleanup-contract.mjs",
    "test:self-concept": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node server/test/self-concept-contract.mjs",
    "test:guard": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node server/test/guard-contract.mjs",
    "test:trust": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node server/test/trust-contract.mjs",
    "test:self-update": "node server/test/self-update-contract.mjs",
    "test:injector": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node server/test/memory-injector-contract.mjs",
    "test:harvest": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node server/test/harvest-contract.mjs",
    "test:assembler": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node server/test/assembler-contract.mjs",
    "test:temporal": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node server/test/temporal-contract.mjs",
    "test:executor": "node server/test/executor-contract.mjs",
    "test:curation": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node --env-file-if-exists=.env server/test/curation-contract.mjs",
    "test:mirror": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node server/test/mirror-contract.mjs",
    "test:transcript": "node server/test/transcript-contract.mjs",
    "test:health": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node --env-file-if-exists=.env server/test/health-contract.mjs",
    "test:tools": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node --env-file-if-exists=.env server/test/tools-contract.mjs",
    "test:schedule": "node server/test/schedule-contract.mjs",
    "test:ingest": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node server/test/ingest-contract.mjs",
    "test:outline": "node server/test/outline-contract.mjs",
    "test:identity": "DATA_DIR=$(mktemp -d) node server/test/identity-contract.mjs",
    "graph-server": "node --env-file-if-exists=.env server/dist/mcp/graph-server.js",
    "test:graph-server": "node server/test/graph-server-contract.mjs",
    "test:writing": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) node server/test/writing-contract.mjs",
    "test:plan": "node server/test/plan-contract.mjs",
    "test:recovery": "node server/test/recovery-contract.mjs",
    "test:steps": "node server/test/step-runner-contract.mjs",
    "test:supervisor": "DATA_DIR=$(mktemp -d) AGENT_HOME=$(mktemp -d) SUPERVISOR_TIMEOUT_MS=200 node server/test/supervisor-contract.mjs",
    "test:e2e": "node --env-file-if-exists=.env server/test/e2e.mjs"
  }
}
